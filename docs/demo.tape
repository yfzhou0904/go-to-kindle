Output docs/assets/demo.gif

Set Shell "bash"
Set FontFamily "DejaVu Sans Mono"
Set FontSize 18
Set Width 1200
Set Height 650
Set Padding 24
Set Framerate 20
Set TypingSpeed 35ms
Set Theme {"name":"go-to-kindle","black":"#1e1e2e","red":"#f38ba8","green":"#a6e3a1","yellow":"#f9e2af","blue":"#89b4fa","magenta":"#cba6f7","cyan":"#94e2d5","white":"#cdd6f4","brightBlack":"#585b70","brightRed":"#f38ba8","brightGreen":"#a6e3a1","brightYellow":"#f9e2af","brightBlue":"#89b4fa","brightMagenta":"#cba6f7","brightCyan":"#94e2d5","brightWhite":"#ffffff","background":"#1e1e2e","foreground":"#cdd6f4","selectionBackground":"#45475a","cursorAccent":"#1e1e2e","cursor":"#f5e0dc"}

Hide
Type "mkdir -p /tmp/go-to-kindle-demo/.go-to-kindle && echo W2VtYWlsXQpzbXRwX3NlcnZlciA9ICJzbXRwLmV4YW1wbGUuY29tIgpwb3J0ID0gNDY1CmZyb20gPSAicmVhZGVyQGV4YW1wbGUuY29tIgpwYXNzd29yZCA9ICJkZW1vIgp0byA9ICJyZWFkZXJAa2luZGxlLmNvbSIK | base64 -d > /tmp/go-to-kindle-demo/.go-to-kindle/config.toml && ln -sf '/workspace/testdata/Test-Driven Development with an LLM for Fun and Profit - blog.yfzhou.webarchive' /tmp/article.webarchive"
Enter
Type "clear"
Enter
Show

Type "HOME=/tmp/go-to-kindle-demo ./bin/go-to-kindle"
Enter
Sleep 2s
Type "/tmp/article.webarchive"
Sleep 1s
Enter
Sleep 6s
Type " — ready for Kindle"
Sleep 2s
Tab
Type " "
Sleep 2s
Type " "
Sleep 2s
